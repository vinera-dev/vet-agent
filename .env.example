AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=<nome-do-deployment>

AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<nome-do-deployment-de-embeddings>

DATABASE_URL=postgresql://vet:vet@localhost:5432/vet_agent

EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSIONS=1536
VECTOR_STORE_BACKEND=memory
FAQ_DIRECTORY=data/faq
RAG_TOP_K=3
RAG_MIN_SCORE=0.1
AGENT_RATE_LIMIT_REQUESTS=20
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
LLM_BACKEND=azure
